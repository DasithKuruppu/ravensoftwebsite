# Copy to .env for local development. Nothing here is read in production —
# the Lambda gets its secrets from SSM and the SPA gets its keys at build time.

# ── Clerk ───────────────────────────────────────────────────────────────────
# Both come from the Clerk dashboard: API keys → your instance.
# The publishable key ships to browsers by design.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# The issuer is your Clerk Frontend API URL, no trailing slash.
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev
# Server-side only. Lets the API read a signed-in user's email and phone.
# Without it everyone is treated as a non-owner.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# ── Who is the owner ────────────────────────────────────────────────────────
# Comma-separated. Decides who may confirm bookings and edit rates. The API
# enforces it; VITE_OWNER_EMAILS only decides whether the Admin tab is drawn.
OWNER_EMAILS=you@example.com
VITE_OWNER_EMAILS=you@example.com

# ── Local shortcuts ─────────────────────────────────────────────────────────
# Skip Clerk entirely and treat every request as a signed-in test customer.
# Ignored on a deployed Lambda; see api/auth.mjs.
# DEV_FAKE_USER=1
# DEV_FAKE_OWNER=1

# ── Storage ─────────────────────────────────────────────────────────────────
# `memory` (the default locally) keeps everything in the process — no AWS, no
# Docker. Set STORE=ddb with DDB_ENDPOINT to use DynamoDB Local instead.
# STORE=memory

# ── Google Maps ─────────────────────────────────────────────────────────────
# TWO keys, deliberately. Never use one for both.
#
# Server key: Places API (New) + Routes API. Restrict it by API, and by nothing
# else — a Lambda has no referrer and no fixed IP. Stays out of the bundle.
GOOGLE_MAPS_API_KEY=AIzaSy-server-key-here
# Browser key: Maps JavaScript API only, restricted by HTTP referrer to
# fleet.ravensoft.click and localhost. This one ships to browsers by design;
# the referrer restriction is what stops it being spent by anyone else.
VITE_GOOGLE_MAPS_BROWSER_KEY=AIzaSy-browser-key-here
