{
  "name": "fleet-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Advance booking for long hires — pick a route, get a price instantly, request the ride.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node api/local-server.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "AWS_PROFILE=${AWS_PROFILE:-scrawl} bash scripts/deploy.sh",
    "deploy:frontend": "AWS_PROFILE=${AWS_PROFILE:-scrawl} bash scripts/deploy-frontend.sh",
    "synth": "npm --prefix infra run synth",
    "logs:api": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws logs tail /aws/lambda/fleet-booking-api --region us-east-1 --follow",
    "whoami": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws sts get-caller-identity"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@clerk/clerk-react": "^5.20.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
