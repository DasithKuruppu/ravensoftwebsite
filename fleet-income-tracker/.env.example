# Copy to .env and fill in. .env is gitignored — never commit real values.
# In AWS these all come from SSM Parameter Store (SecureString), not from .env.

# ── Uber Supplier API (scripts/uber-check.mjs) ──
UBER_CLIENT_ID=nqqC6Vjo8cQ0pPhv9BNnmNSkyOcKsu93
UBER_CLIENT_SECRET=your-uber-client-secret-here

# ── DAGPS tracker portal (phase 2 — scripts/dagps-sync.mjs) ──
# Log in by LICENCE PLATE, not via the account section — DAGPS_USER holds the
# vehicle's plate / device identifier, not a user account name.
DAGPS_USER=your-vehicle-licence-plate
DAGPS_PASS=your-dagps-password

# ── Local API auth ──
# Leave these unset for local dev and the API falls back to
#   owner / owner123  and  driver / driver123
# Generate real hashes with:  npm run hash-password -- 'the-password'
# JWT_SECRET=
# OWNER_PASSWORD_HASH=
# DRIVER_PASSWORD_HASH=

# ── Local storage ──
# Unset            → JSON file store at .local/store.json (no Docker needed)
# http://localhost:8000 → DynamoDB Local via docker compose
# DDB_ENDPOINT=http://localhost:8000
TABLE_NAME=fleet-tracker
