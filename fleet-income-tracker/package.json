{
  "name": "fleet-income-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily revenue tracking for a fleet Uber driver against a tiered commission plan.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node api/local-server.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ddb:up": "docker compose up -d",
    "ddb:down": "docker compose down",
    "ddb:create-table": "node scripts/create-table.mjs",
    "seed": "node scripts/seed.mjs",
    "uber:check": "node scripts/uber-check.mjs",
    "dagps:sync": "node scripts/dagps-sync.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "deploy": "AWS_PROFILE=${AWS_PROFILE:-scrawl} bash scripts/deploy.sh",
    "deploy:frontend": "AWS_PROFILE=${AWS_PROFILE:-scrawl} bash scripts/deploy-frontend.sh",
    "synth": "npm --prefix infra run synth",
    "sync:gps": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws lambda invoke --region us-east-1 --function-name fleet-tracker-sync --payload '{\"job\":\"dagps\"}' --cli-binary-format raw-in-base64-out /dev/stdout",
    "logs:api": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws logs tail /aws/lambda/fleet-tracker-api --region us-east-1 --follow",
    "logs:sync": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws logs tail /aws/lambda/fleet-tracker-sync --region us-east-1 --follow",
    "whoami": "AWS_PROFILE=${AWS_PROFILE:-scrawl} aws sts get-caller-identity"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
